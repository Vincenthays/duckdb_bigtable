# Same base as DuckDB's own linux_amd64 builds: glibc 2.28 (runs on almost any distro), GCC 14 toolset for C++26
FROM quay.io/pypa/manylinux_2_28_x86_64

RUN dnf install -y -q zip kernel-headers perl && pipx install ninja

ARG VCPKG_TAG=2026.10.16
WORKDIR /opt
RUN git clone --depth 1 --branch ${VCPKG_TAG} https://github.com/microsoft/vcpkg.git && ./vcpkg/bootstrap-vcpkg.sh -disableMetrics
ENV VCPKG_ROOT=/opt/vcpkg

WORKDIR /app
COPY vcpkg.json ./
RUN /opt/vcpkg/vcpkg install --x-install-root=/app/build/vcpkg_installed
COPY . ./
RUN make build CMAKE_ARGS="-DDUCKDB_PLATFORM=linux_amd64 -DVCPKG_INSTALLED_DIR=/app/build/vcpkg_installed"

FROM google/cloud-sdk:slim
WORKDIR /app
COPY --from=0 /app/build/bigtable2.duckdb_extension .
RUN gzip bigtable2.duckdb_extension
